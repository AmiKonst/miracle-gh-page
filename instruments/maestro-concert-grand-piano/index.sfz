<control>
default_path=Samples/

label_cc7=Vol
label_cc10=Pan
label_cc64=Sus.Pedal
label_cc66=Mid.Pedal
label_cc67=Lid
label_cc72=Release
label_cc80=Rel.Noise
label_cc81=Ped.Noise
label_cc99=Veltrack

set_cc7=100
set_hdcc10=0.5
set_hdcc72=0.575
set_hdcc80=1
set_hdcc81=0.1
set_hdcc99=1


//**************************************************************

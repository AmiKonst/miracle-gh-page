// Splendid Grand Piano - full explicit 88-key index
// Derived directly from the original PP/MP/MF/FF key ranges.
// Every MIDI key 21..108 is explicitly mapped in every velocity layer.
// Source sample extensions were changed to .webm to match the converted Samples folder.

<control>
default_path=Samples/

<global>
amplitude_oncc7=100
amplitude_curvecc7=4
pan_oncc10=100
pan_curvecc10=1
ampeg_attack=0.0005
ampeg_hold=8
ampeg_hold_oncc133=-6
ampeg_decay=80
ampeg_decay_oncc133=-60
ampeg_sustain=0
ampeg_release_oncc72=2
amp_veltrack_oncc99=-100
amp_veltrack_curvecc99=2
note_polyphony=1
off_time=0.5
sustain_cc=90 //re-route default sustain pedal to CC90
ampeg_dynamic=1 //allow envelope to update on CC64 change
ampeg_release_shape=-6 //set the sustain curve dropoff curvature
ampeg_releasecc64=15 //make maximum release time 15 seconds
ampeg_release_curvecc64=11 //use the curve_index 11

<curve>curve_index=11
v000=0
v032=0
v042=.1
v064=.3
v072=.4
v073=1
v127=1

<group>
group=1
locc64=65
locc70=1
amplitude_oncc70=200
group_volume=-11
ampeg_attack=0.1
